# Required: hex-encoded BSV private key (64 chars)
PRIVATE_KEY=

# Optional: main or test (default in Compose: main)
CHAIN=main

# Optional: wallet storage provider URL
STORAGE_URL=https://store-us-1.bsvb.tech

# Optional: git source for articles. Defaults publish this repo's content/ directory.
CONTENT_REPO=bsv-blockchain-demos/402-articles
CONTENT_BRANCH=main
CONTENT_PATH=content
CONTENT_POLL_MS=180000
CONTENT_SOURCE=github

# Optional: GitHub token with contents read, for a private repo or extra replicas
CONTENT_GITHUB_TOKEN=

# Optional: bearer token that enables POST /content/refresh
CONTENT_REFRESH_TOKEN=

# Optional: comma-separated HTTPS hosts for /double/proxy. Empty disables it.
DOUBLE_PROXY_ALLOW_HOSTS=
