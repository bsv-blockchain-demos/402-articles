{
  "name": "article",
  "version": "1.0.12",
  "description": "Substack-like article reader with BSV 402 payment middleware",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "tsc -p tsconfig.test.json --noEmit && tsx --test test/*.test.ts"
  },
  "overrides": {
    "@bsv/sdk": "2.1.3"
  },
  "keywords": [
    "bsv",
    "402",
    "payment",
    "substack"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@bsv/402-pay": "^0.1.4",
    "@bsv/sdk": "2.1.3",
    "@bsv/wallet-toolbox": "^2.1.28",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "marked": "^15.0.12",
    "sanitize-html": "^2.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/sanitize-html": "^2.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.5.0"
  }
}
